# --- Client (bundled into static export) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

# Optional. Defaults to "/ingest" (same-origin reverse proxy via public/_redirects).
# In local dev, set this to the direct URL since _redirects only applies on Cloudflare Pages:
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Cloudflare Pages Functions (server-side only, set in CF dashboard) ---
# For local function testing, put these in .dev.vars (gitignored) and run `wrangler pages dev`.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The full PEM, including BEGIN/END lines. In .dev.vars use literal newlines.
# In the Cloudflare dashboard, paste the PEM as-is (it accepts multi-line values).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
